Bootstrap: docker
From: ubuntu:26.04

%post -c /bin/bash

  set -euo pipefail

  UBUNTU_VERSION=2604
  GCC_VERSION=16.2.0
  BOOST_VERSION=1.92.0
  CMAKE_VERSION=4.4.3
  DIFFTASTIC_VERSION=0.70.0
  DEMUMBLE_VERSION=main
  MOLD_VERSION=2.42.0
  WILD_VERSION=0.10.0
  CABIN_VERSION=0.17.0

  export DEBIAN_FRONTEND=noninteractive
  ARCH=$(uname -m)
  WIN_ARCH_0=${ARCH//86_/}
  WIN_ARCH=${WIN_ARCH_0//aarch/arm}

  /installer/ubuntu${UBUNTU_VERSION}_prelude.bash
  /installer/ubuntu_gcc.bash ${UBUNTU_VERSION} ${GCC_VERSION}
  apt-get install -y --no-install-recommends make pkg-config ninja-build meson lcov gcovr git less
  /installer/ubuntu_clang.bash 23 /opt/gcc-${GCC_VERSION}
  /installer/ubuntu_clang-format.bash 21
  /installer/ubuntu_clang-format.bash 22
  /installer/ubuntu2404_msvc-wine_prerequisites.bash
  /installer/cmake.bash ${CMAKE_VERSION}
  /installer/ubuntu_boost.bash ${UBUNTU_VERSION} ${BOOST_VERSION} gcc-${GCC_VERSION}
  PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin PIPX_MAN_DIR=/usr/local/share CONAN_HOME=/opt/conan_home /installer/conan.bash
  PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin PIPX_MAN_DIR=/usr/local/share /installer/cpplint.bash
  PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin PIPX_MAN_DIR=/usr/local/share /installer/clangd-tidy.bash
  PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin PIPX_MAN_DIR=/usr/local/share /installer/compiledb.bash
  /installer/difftastic.bash ${DIFFTASTIC_VERSION}
  /installer/demumble.bash ${DEMUMBLE_VERSION}
  /installer/mold.bash ${MOLD_VERSION}
  /installer/wild.bash ${WILD_VERSION}
  /installer/cabin.bash ${CABIN_VERSION}
  /installer/ubuntu2404_postlude.bash
  apt-get clean
  rm -rf /var/lib/apt/lists/* /var/cache/apt/*

  CUSTOM_ENV=/.singularity.d/env/99-zz_custom_env.sh
  echo "#!/bin/bash" > ${CUSTOM_ENV}
  echo 'export PATH=${PATH}:'"/opt/cmake-${CMAKE_VERSION}/bin:/opt/gcc-${GCC_VERSION}/bin:/opt/difftastic-${DIFFTASTIC_VERSION}/bin:/opt/demumble-${DEMUMBLE_VERSION}/bin:/opt/mold-${MOLD_VERSION}/bin:/opt/wild-${WILD_VERSION}/bin:/opt/cabin-${CABIN_VERSION}/bin:/opt/msvc/bin/${WIN_ARCH}" >> ${CUSTOM_ENV}
  echo 'export CPLUS_INCLUDE_PATH=${CPLUS_INCLUDE_PATH:+${CPLUS_INCLUDE_PATH}:}'"/opt/boost/${BOOST_VERSION}/gcc-${GCC_VERSION}/include" >> ${CUSTOM_ENV}
  echo 'export LIBRARY_PATH=${LIBRARY_PATH:+${LIBRARY_PATH}:}'"/opt/boost/${BOOST_VERSION}/gcc-${GCC_VERSION}/lib" >> ${CUSTOM_ENV}
  echo 'export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:+${LD_LIBRARY_PATH}:}'"/opt/boost/${BOOST_VERSION}/gcc-${GCC_VERSION}/lib" >> ${CUSTOM_ENV}
  cat >> ${CUSTOM_ENV} << 'EOF'
export PIPX_HOME=/opt/pipx
export PIPX_BIN_DIR=/usr/local/bin
export PIPX_MAN_DIR=/usr/local/share
export CONAN_HOME=/opt/conan_home
export FONTCONFIG_FILE=/opt/fontconf/dummy.conf
export WINEDEBUG=-all
export WINEPREFIX=/opt/wineprefix
