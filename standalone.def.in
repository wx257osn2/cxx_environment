Bootstrap: docker
From: ubuntu:24.04

%post -c /bin/bash

  set -euo pipefail

  GCC_VERSION=15.1.0
  BOOST_VERSION=1.88.0
  CMAKE_VERSION=4.0.1

  DEBIAN_FRONTEND=noninteractive

  /installer/ubuntu2404_prelude.bash
  /installer/ubuntu2404_gcc15.bash ${GCC_VERSION}
  apt-get install -y --no-install-recommends make pkg-config ninja-build meson lcov gcovr git
  /installer/ubuntu2404_clang20.bash
  /installer/ubuntu2404_clang-format17.bash
  /installer/ubuntu2404_clang-format18.bash
  /installer/ubuntu2404_clang-format19.bash
  /installer/cmake.bash ${CMAKE_VERSION}
  /installer/ubuntu2404_boost.bash ${BOOST_VERSION} gcc-${GCC_VERSION}
  PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin PIPX_MAN_DIR=/usr/local/share CONAN_HOME=/opt/conan_home /installer/conan.bash
  PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin PIPX_MAN_DIR=/usr/local/share /installer/cpplint.bash
  PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin PIPX_MAN_DIR=/usr/local/share /installer/clangd-tidy.bash
  PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin PIPX_MAN_DIR=/usr/local/share /installer/compiledb.bash
  /installer/ubuntu2404_postlude.bash

  CUSTOM_ENV=/.singularity.d/env/99-zz_custom_env.sh
  echo "#!/bin/bash" > ${CUSTOM_ENV}
  echo 'export PATH=${PATH}:'"/opt/cmake-${CMAKE_VERSION}/bin" >> ${CUSTOM_ENV}
  echo 'export CPLUS_INCLUDE_PATH=${CPLUS_INCLUDE_PATH:+${CPLUS_INCLUDE_PATH}:}'"/opt/boost/${BOOST_VERSION}/gcc-${GCC_VERSION}/include" >> ${CUSTOM_ENV}
  echo 'export LIBRARY_PATH=${LIBRARY_PATH:+${LIBRARY_PATH}:}'"/opt/boost/${BOOST_VERSION}/gcc-${GCC_VERSION}/lib" >> ${CUSTOM_ENV}
  echo 'export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:+${LD_LIBRARY_PATH}:}'"/opt/boost/${BOOST_VERSION}/gcc-${GCC_VERSION}/lib" >> ${CUSTOM_ENV}
  cat >> ${CUSTOM_ENV} << 'EOF'
export PIPX_HOME=/opt/pipx
export PIPX_BIN_DIR=/usr/local/bin
export PIPX_MAN_DIR=/usr/local/share
export CONAN_HOME=/opt/conan_home
